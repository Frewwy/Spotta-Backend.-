// Watches Telegram group chats for contract addresses people post, runs them through
// SPOTTA's checks, and replies with a score — so "alpha calls" get auto-screened instead
// of manually copy-pasted into the browser tools.
//
// Only starts if TELEGRAM_BOT_TOKEN is set in the environment. Safe to leave unset.

const TelegramBot = require('node-telegram-bot-api');
const { Pool } = require('pg');

const SOLANA_ADDR = /\b[1-9A-HJ-NP-Za-km-z]{32,44}\b/g;   // base58, no 0/O/I/l
const EVM_ADDR = /\b0x[a-fA-F0-9]{40}\b/g;

function startTelegramBot(pool) {
  const token = process.env.TELEGRAM_BOT_TOKEN;
  if (!token) {
    console.log('TELEGRAM_BOT_TOKEN not set — Telegram scanner bot not started.');
    return;
  }

  const bot = new TelegramBot(token, { polling: true });
  console.log('SPOTTA Telegram scanner bot started.');

  bot.on('message', async (msg) => {
    const text = msg.text || '';
    const chatId = msg.chat.id;

    const solMatches = [...new Set(text.match(SOLANA_ADDR) || [])];
    const evmMatches = [...new Set(text.match(EVM_ADDR) || [])];

    for (const addr of solMatches) {
      try {
        const result = await checkSolanaToken(addr);
        if (result) {
          await bot.sendMessage(chatId, formatReply(addr, result), { reply_to_message_id: msg.message_id });
          await logInspection(pool, 'telegram-sol', 'solana', addr, result);
        }
      } catch (e) { console.warn('Solana check failed for', addr, e.message); }
    }

    for (const addr of evmMatches) {
      try {
        const result = await checkEvmToken(addr);
        if (result) {
          await bot.sendMessage(chatId, formatReply(addr, result), { reply_to_message_id: msg.message_id });
          await logInspection(pool, 'telegram-evm', result.chain, addr, result);
        }
      } catch (e) { console.warn('EVM check failed for', addr, e.message); }
    }
  });

  bot.on('polling_error', (e) => console.warn('Telegram polling error:', e.message));
}

// --- GoPlus Security check: honeypot + liquidity-lock detection ------------
const GOPLUS_EVM_CHAIN_IDS = {
  ethereum: '1', bsc: '56', base: '8453', arbitrum: '42161', polygon: '137', robinhood: '4663'
};

async function checkGoPlusSolana(mint) {
  try {
    const res = await fetch(`https://api.gopluslabs.io/api/v1/solana/token_security?contract_addresses=${mint}`);
    if (!res.ok) return null;
    const data = await res.json();
    const info = data.result?.[mint] || data.result?.[mint.toLowerCase()] || data[mint] || null;
    if (!info) return null;

    const findings = [];
    let penalty = 0;
    if (info.mintable?.status === '1') { penalty += 100; findings.push('mintable (GoPlus)'); }
    if (info.freezable?.status === '1') { penalty += 20; findings.push('freezable (GoPlus)'); }
    if (info.closable?.status === '1') { penalty += 40; findings.push('programme closable — all assets could be eliminated'); }
    if (info.transfer_hook?.address) { penalty += 20; findings.push('has a transfer hook — could block trading'); }
    if (info.default_account_state === '2') { penalty += 60; findings.push('new accounts frozen by default'); }

    const lpHolders = info.dex?.[0]?.lp_holders || [];
    if (lpHolders.length) {
      const unlockedTop = lpHolders.filter(h => h.is_locked !== 1 && h.is_locked !== '1' && parseFloat(h.percent || 0) > 0.05);
      if (unlockedTop.length) { penalty += 35; findings.push('significant unlocked LP position(s) found'); }
    }
    return { penalty, findings, source: 'goplus' };
  } catch (e) { console.warn('GoPlus Solana check failed:', e.message); return null; }
}

async function checkGoPlusEvm(chain, address) {
  const chainId = GOPLUS_EVM_CHAIN_IDS[chain];
  if (!chainId) return null;
  try {
    const res = await fetch(`https://api.gopluslabs.io/api/v1/token_security/${chainId}?contract_addresses=${address}`);
    if (!res.ok) return null;
    const data = await res.json();
    const info = data.result?.[address.toLowerCase()] || data.result?.[address] || data[address] || null;
    if (!info) return null;

    const findings = [];
    let penalty = 0;
    if (info.is_honeypot === '1') { penalty += 100; findings.push('HONEYPOT — cannot sell (GoPlus)'); }
    if (info.cannot_sell_all === '1') { penalty += 40; findings.push('cannot sell full balance'); }
    if (parseFloat(info.sell_tax || 0) > 0.15) { penalty += 30; findings.push(`high sell tax (${(parseFloat(info.sell_tax)*100).toFixed(0)}%)`); }
    if (info.is_blacklisted === '1') { penalty += 30; findings.push('blacklist function present'); }
    if (info.hidden_owner === '1') { penalty += 30; findings.push('hidden owner — often malicious intent'); }
    if (info.selfdestruct === '1') { penalty += 40; findings.push('contract can self-destruct'); }
    if (info.owner_change_balance === '1') { penalty += 40; findings.push('owner can directly alter holder balances'); }

    const lpHolders = info.lp_holders || [];
    if (lpHolders.length) {
      const unlockedTop = lpHolders.filter(h => h.is_locked !== 1 && h.is_locked !== '1' && parseFloat(h.percent || 0) > 0.05);
      if (unlockedTop.length) { penalty += 35; findings.push('significant unlocked LP position(s) found'); }
    }
    return { penalty, findings, source: 'goplus' };
  } catch (e) { console.warn('GoPlus EVM check failed:', e.message); return null; }
}

// --- Solana check: mint/freeze authority + real holder concentration ------
async function checkSolanaToken(mint) {
  const rpcUrl = process.env.SOLANA_RPC_URL || 'https://api.mainnet-beta.solana.com';
  const rpc = async (method, params) => {
    const res = await fetch(rpcUrl, {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ jsonrpc: '2.0', id: 1, method, params })
    });
    if (res.status === 429) throw new Error('rate limited');
    const data = await res.json();
    return data.result;
  };

  const mintInfo = await rpc('getParsedAccountInfo', [mint, { encoding: 'jsonParsed' }]);
  const info = mintInfo?.value?.data?.parsed?.info;
  if (!info) return null;

  const largest = await rpc('getTokenLargestAccounts', [mint]);
  const holders = largest?.value || [];
  const supply = parseFloat(info?.supply || 0);

  let realHolders = holders;
  const topN = holders.slice(0, 6);
  if (topN.length && supply) {
    const tokenAcctInfos = await rpc('getMultipleAccounts', [topN.map(h => h.address), { encoding: 'jsonParsed' }]);
    const ownerAddrs = topN.map((h, i) => tokenAcctInfos?.value?.[i]?.data?.parsed?.info?.owner || null);
    const validPairs = ownerAddrs.map((addr, i) => ({ addr, i })).filter(p => p.addr);
    if (validPairs.length) {
      const ownerAccInfos = await rpc('getMultipleAccounts', [validPairs.map(p => p.addr), { encoding: 'jsonParsed' }]);
      const isProgramControlled = new Array(topN.length).fill(false);
      validPairs.forEach((p, j) => {
        const acc = ownerAccInfos?.value?.[j];
        if (acc && acc.owner && acc.owner !== '11111111111111111111111111111111') isProgramControlled[p.i] = true;
      });
      realHolders = [...topN.filter((h, i) => !isProgramControlled[i]), ...holders.slice(topN.length)];
    }
  }
  const top1 = realHolders[0] && supply ? (parseFloat(realHolders[0].amount) / supply * 100) : null;

  let score = 100;
  const findings = [];
  if (info.mintAuthority) { score -= 100; findings.push('mint authority active'); }
  if (info.freezeAuthority) { score -= 20; findings.push('freeze authority active'); }
  if (top1 !== null) {
    if (top1 > 30) { score -= 45; findings.push(`top wallet holds ${top1.toFixed(1)}%`); }
    else if (top1 > 15) { score -= 20; findings.push(`top wallet holds ${top1.toFixed(1)}%`); }
  } else {
    score -= 25; findings.push('concentration unverified (likely pre-graduation)');
  }

  const goplus = await checkGoPlusSolana(mint);
  if (goplus) { score -= goplus.penalty; findings.push(...goplus.findings); }
  else { findings.push('GoPlus check unavailable for this token'); }

  score = Math.max(0, Math.min(100, Math.round(score)));

  return { chain: 'solana', score, outcome: scoreToOutcome(score), findings, url: `https://pump.fun/${mint}` };
}

// --- EVM check: liquidity/volume via DexScreener's documented API ----------
async function checkEvmToken(address) {
  const res = await fetch(`https://api.dexscreener.com/latest/dex/tokens/${address}`);
  if (!res.ok) return null;
  const data = await res.json();
  const pairs = data.pairs || [];
  if (!pairs.length) return null;

  const best = pairs.reduce((a, b) => (b.liquidity?.usd || 0) > (a.liquidity?.usd || 0) ? b : a);
  const liq = best.liquidity?.usd || 0;
  const mcap = best.marketCap || best.fdv || 0;
  const vol1h = best.volume?.h1 || 0;

  let score = 100;
  const findings = [];
  if (liq < 2000) { score -= 45; findings.push('thin liquidity'); }
  else if (mcap > 0 && liq / mcap < 0.02) { score -= 20; findings.push('liquidity small vs market cap'); }
  if (mcap > 0 && vol1h / mcap < 0.005) { score -= 20; findings.push('little trading activity'); }

  const goplus = await checkGoPlusEvm(best.chainId, address);
  if (goplus) { score -= goplus.penalty; findings.push(...goplus.findings); }
  else { findings.push('GoPlus check unavailable (unmapped chain or lookup failed)'); }

  score = Math.max(0, Math.min(100, Math.round(score)));

  return { chain: best.chainId, score, outcome: scoreToOutcome(score), findings, url: best.url };
}

function scoreToOutcome(score) {
  if (score >= 70) return 'PASS';
  if (score >= 40) return 'CAUTION';
  return 'FAIL';
}

function formatReply(addr, result) {
  const emoji = { PASS: '🟢', CAUTION: '🟡', FAIL: '🔴' }[result.outcome];
  const short = addr.slice(0, 4) + '…' + addr.slice(-4);
  const findingsStr = result.findings.length ? `\n${result.findings.join(', ')}` : '';
  return `${emoji} ${short} (${result.chain})\nScore: ${result.score}/100 — ${result.outcome}${findingsStr}\n${result.url}\n\n⚠ Not financial advice. Objective checks only.`;
}

async function logInspection(pool, tool, chain, tokenAddress, result) {
  try {
    await pool.query(
      `INSERT INTO inspections (tool, chain, token_address, outcome, score) VALUES ($1,$2,$3,$4,$5)`,
      [tool, chain, tokenAddress, result.outcome.toLowerCase(), result.score]
    );
  } catch (e) { console.warn('Failed to log Telegram scan to DB:', e.message); }
}

module.exports = { startTelegramBot };
